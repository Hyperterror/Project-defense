{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://project-defense-coach/schemas/challenge.schema.json",
  "title": "Challenge Manifest",
  "description": "Manifest for a coding challenge generated from a project graph.",
  "type": "object",
  "required": [
    "challenge_id",
    "repository_revision",
    "feature",
    "type",
    "difficulty",
    "source_references",
    "objective",
    "workspace",
    "checks",
    "hint_policy",
    "hints",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "challenge_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique challenge identifier, format: challenge-<8-char-hash>"
    },
    "repository_revision": {
      "type": "string",
      "minLength": 1,
      "description": "Git commit hash of the repo at challenge creation time, or 'unversioned'."
    },
    "feature": {
      "type": "string",
      "minLength": 1,
      "description": "The feature or module being practiced."
    },
    "type": {
      "type": "string",
      "enum": ["function_reconstruction", "bug_fix", "test_writing"],
      "description": "Challenge type."
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard"],
      "description": "Difficulty level."
    },
    "source_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "lines", "description"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "lines": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 },
            "minItems": 1,
            "maxItems": 2
          },
          "description": { "type": "string" }
        }
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "description": "What the learner must accomplish."
    },
    "workspace": {
      "type": "object",
      "required": ["allowed_files", "starter_file"],
      "additionalProperties": false,
      "properties": {
        "allowed_files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Files copied into the workspace from starter/."
        },
        "starter_file": {
          "type": "string",
          "minLength": 1,
          "description": "Primary file the learner edits."
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "command", "expected_exit_code", "timeout_seconds"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "command": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "expected_exit_code": { "type": "integer" },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 30 }
        }
      }
    },
    "hint_policy": {
      "type": "object",
      "required": ["reveal_after_attempts", "max_hints"],
      "additionalProperties": false,
      "properties": {
        "reveal_after_attempts": { "type": "integer", "minimum": 0 },
        "max_hints": { "type": "integer", "minimum": 1 }
      }
    },
    "hints": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 4,
      "maxItems": 4,
      "description": "Exactly 4 hints, from least to most revealing."
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "abandoned"]
    }
  }
}
