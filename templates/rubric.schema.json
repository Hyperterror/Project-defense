{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://project-defense-coach/schemas/rubric.schema.json",
  "title": "Rubric",
  "description": "Machine-readable scoring rubric for a single interview question.",
  "type": "object",
  "required": ["id", "question_id", "expected_concepts", "scoring_levels", "max_score"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique rubric identifier, e.g. explanation-auth-v1."
    },
    "question_id": {
      "type": "string",
      "minLength": 1,
      "description": "Links this rubric to a question in the question bank."
    },
    "expected_concepts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "List of concepts the answer must address."
    },
    "scoring_levels": {
      "type": "object",
      "description": "Keys are concept strings (must match expected_concepts). Values describe each 0-3 level.",
      "additionalProperties": {
        "type": "object",
        "required": ["0", "1", "2", "3"],
        "additionalProperties": false,
        "properties": {
          "0": { "type": "string", "minLength": 1 },
          "1": { "type": "string", "minLength": 1 },
          "2": { "type": "string", "minLength": 1 },
          "3": { "type": "string", "minLength": 1 }
        }
      }
    },
    "max_score": {
      "type": "integer",
      "minimum": 1,
      "description": "Sum of maximum level (3) across all concepts."
    }
  }
}
